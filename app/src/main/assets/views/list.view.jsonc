{
  "version": 1,
  "id": "list",
  "states": {
    "number": {
      "type": "string",
      "initial": ""
    },
    "notes": {
      "type": "string",
      "initial": ""
    },
    "status": {
      "type": "string",
      "initial": ""
    }
  },
  "view": {
    "type": "Scroll",
    "children": [
      {
        "type": "Column",
        "props": {
          "padding": 20,
          "spacing": 12,
          "fillWidth": true
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "text": "Notas Rápidas"
            },
            "style": {
              "fontSize": 28
            }
          },
          {
            "type": "Text",
            "props": {
              "text": "Suas ideias, salvas neste aparelho."
            }
          },
          {
            "type": "Button",
            "props": {
              "text": "Nova nota",
              "action": "new",
              "fillWidth": true
            }
          },
          {
            "type": "Text",
            "bind": {
              "text": "notes"
            }
          },
          {
            "type": "Input",
            "props": {
              "placeholder": "Número da nota"
            },
            "bind": {
              "value": "number"
            }
          },
          {
            "type": "Button",
            "props": {
              "text": "Abrir nota",
              "action": "open",
              "fillWidth": true
            }
          },
          {
            "type": "Button",
            "props": {
              "text": "Excluir nota",
              "action": "delete",
              "fillWidth": true
            }
          },
          {
            "type": "Text",
            "bind": {
              "text": "status"
            }
          }
        ]
      }
    ]
  }
}
